APP_NAME="3D Services"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://debarras3d.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=info

POSTGRES_DB=3dservices
POSTGRES_USER=3dservices
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=3dservices
DB_USERNAME=3dservices
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=.debarras3d.fr
SANCTUM_STATEFUL_DOMAINS=debarras3d.fr,www.debarras3d.fr

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS=contact@debarras3d.fr
MAIL_FROM_NAME="3D Services"

VITE_API_URL=/api
VITE_API_BASE_URL=
VITE_RECAPTCHA_SITE_KEY=CHANGE_ME

RUN_MIGRATIONS=true
RUN_SEEDERS=false
RUN_SEEDERS_ONCE=true
